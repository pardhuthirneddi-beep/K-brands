# K-brands — environment template
#
# Copy to `.env.local` for local work (that file is git-ignored) or set these in the
# deployment platform. There are no third-party services required: the datastore is
# node:sqlite and the mail queue is a table.
#
# Everything marked "fail-closed" means the app refuses the corresponding customer
# action until you set it. That is intentional — see docs/owner-approval-checklist.md.

# ── Secrets ────────────────────────────────────────────────────────────────────────
# Signs sessions, CSRF tokens and test-webhook payloads. REQUIRED in production: the
# app refuses to boot without it. Generate: openssl rand -hex 32
KBRANDS_APP_SECRET=

# ── URLs ───────────────────────────────────────────────────────────────────────────
# Absolute origin used for canonical links, sitemap.xml and robots.txt. No trailing slash.
KBRANDS_SITE_URL=https://www.example.com

# ── Datastore ──────────────────────────────────────────────────────────────────────
# SQLite file path. Must live on persistent disk (not an ephemeral container filesystem).
# KBRANDS_DB_PATH=/var/lib/kbrands/kbrands.sqlite3

# ── Launch switches (all fail-closed) ──────────────────────────────────────────────
# Master gate. While off: pre-launch banner, robots.txt disallows everything, checkout
# refuses to create orders. Flip ONLY after every blocking setting is approved.
# KBRANDS_LIVE_COMMERCE=0

# Show sample catalogue records in the storefront. Development convenience; production
# default is off, and the admin API refuses to *publish* a sample record while live.
# KBRANDS_DEMO_CATALOGUE=1

# Allow sandbox/test orders in a deployed (non-dev) environment, e.g. a staging preview.
# KBRANDS_SANDBOX_ORDERS=0

# ── Payments ───────────────────────────────────────────────────────────────────────
# `mock_sandbox` uses the built-in test adapter (no money moves). A real gateway needs an
# adapter in src/adapters/payment.ts plus its secret. See docs/integrations.md.
# KBRANDS_PAYMENT_PROVIDER=none
# KBRANDS_PAYMENT_SECRET=
# Live capture gate — separates "configured" from "allowed to take money".
# KBRANDS_LIVE_PAYMENTS=0

# Cash on delivery, off until the owner accepts the reconciliation cost of it.
# KBRANDS_COD_ENABLED=0

# ── Shipping ───────────────────────────────────────────────────────────────────────
# `none` means every checkout is refused with "no delivery zones approved". Zones are
# approved in Admin → Settings → shipping.zones (a DB setting, not an env var).
# KBRANDS_SHIPPING_PROVIDER=none
# KBRANDS_SHIPPING_API_KEY=
# KBRANDS_INTL_ENABLED=0

# ── Taxonomy / money ─────────────────────────────────────────────────────────────────
# KBRANDS_DEFAULT_COUNTRY=IN
# KBRANDS_SUPPORTED_COUNTRIES=IN
# KBRANDS_CURRENCY=INR

# ── Email ───────────────────────────────────────────────────────────────────────────
# `none` (default) keeps every notification in the queue table with status
# skipped_no_provider: nothing is lost, nothing is sent. `provider` also requires an key.
# KBRANDS_EMAIL_MODE=none
# KBRANDS_EMAIL_API_KEY=
# KBRANDS_EMAIL_FROM="K-brands <orders@example.com>"

# ── Operational tuning ───────────────────────────────────────────────────────────────
# KBRANDS_SESSION_DAYS=14
# KBRANDS_RESERVATION_MINUTES=20
# KBRANDS_MAX_QTY=10

# ── First-run admin bootstrap ────────────────────────────────────────────────────────
# Consumed by `npm run db:seed-demo` (and only creates/promotes an account if you set
# both). Password minimum is 14 characters.
# KBRANDS_BOOTSTRAP_ADMIN_EMAIL=
# KBRANDS_BOOTSTRAP_ADMIN_PASSWORD=

# ── Embedded Arena demo preview (NEVER a live store) ────────────────────────────────
# Automatically on only inside Arena's E2B sandbox (it supplies E2B_SANDBOX_ID), with the demo
# catalogue on and live commerce off. HTTPS cookies become Partitioned, Secure and SameSite=None so
# one-click owner entry and add-to-bag work inside the iframe. Opt out with 0 and rebuild.
# This variable cannot enable embedding in a live store or outside E2B.
# KBRANDS_PREVIEW_EMBED=0

# ── Debug hatches (never enable in production) ───────────────────────────────────────
# KBRANDS_DISABLE_CSP=1
